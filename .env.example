# Copy this file to .env and fill in your own values. Never commit .env.
# All scripts and services read these variables; defaults point to localhost.

# --- PostgreSQL + pgvector -----------------------------------------------
RAG_DB_HOST=localhost
RAG_DB_PORT=5432
RAG_DB_USER=postgres
RAG_DB_PASSWORD=
RAG_DB_NAME=rag_benchmark

# --- Ollama (local LLMs) ---------------------------------------------------
RAG_OLLAMA_URL=http://localhost:11434/api/generate
# Model that writes the answers in the search service
RAG_OLLAMA_MODELO=qwen2.5:3b
# Model that cleans OCR text in stage 3 (its output must pass the fidelity gate)
RAG_OLLAMA_MODELO_LIMPIEZA=llama3.2:3b

# --- Search and model-comparison service (app/server/app.py) -------------
RAG_SERVER_HOST=127.0.0.1
RAG_SERVER_PORT=5000
# 1 enables Flask debug mode. Keep 0 anywhere other than your own machine.
RAG_DEBUG=0
# Doc2Vec model trained by pipeline/04_vectorizacion_masiva.py
# Default: <repo>/models/modelo_doc2vec.model
# RAG_DOC2VEC_MODEL=

# --- Ingestion service (app/ingesta/servicio.py) --------------------------
# Address used by `python -m app.ingesta.servicio`. Use 0.0.0.0 only with a token set.
RAG_HOST_INGESTA=127.0.0.1
RAG_PUERTO_INGESTA=5001
# Bearer token required by the ingestion endpoints. Empty disables auth,
# which is only acceptable when the service listens on 127.0.0.1.
RAG_TOKEN_API=
# Maximum upload size in MB
RAG_MB_MAXIMO=80
# Working folder for ingestion jobs and archive folder for accepted PDFs
# Defaults: <repo>/data/trabajos_ingesta and <repo>/data/01_raw_pdf
# RAG_DIR_TRABAJOS=
# RAG_DIR_PDF=
